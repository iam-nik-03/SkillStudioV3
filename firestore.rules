rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getAdminEmail() {
      // Use a fallback to the bootstrap email if the doc doesn't exist yet
      // This is for first-run scenarios
      return get(/databases/$(database)/documents/system_config/admin).data.currentAdminEmail;
    }

    function isAdmin() {
      // Strict Admin check: ONLY 03xnik@gmail.com is allowed
      return isVerified() && request.auth.token.email == '03xnik@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.provider is string &&
             data.subscriptionPlan in ['free', 'pro'] &&
             data.learningStats is map;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().email == request.auth.token.email &&
                      incoming().subscriptionPlan == 'free' &&
                      incoming().createdAt == request.time;
      
      allow update: if (isOwner(userId) || isAdmin()) && 
                      isValidUser(incoming()) &&
                      (
                        isAdmin() || (
                          // Users can update their profile or tracking status
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'isOnline', 'lastSeen', 'learningStats'])
                        )
                      );
      
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activity_logs/{logId} {
      // Users can log their own actions (append-only)
      allow create: if isSignedIn() && 
                      incoming().userId == request.auth.uid &&
                      incoming().timestamp == request.time;
      // Only admin can view logs
      allow read: if isAdmin();
    }

    match /system_config/admin {
      // Only admin can see and transfer ownership
      allow read: if isAdmin();
      allow write: if isAdmin() && 
                      incoming().currentAdminEmail is string &&
                      incoming().currentAdminEmail.size() <= 200;
    }
  }
}
