{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "subscriptionPlan": { "type": "string", "enum": ["free", "pro"] },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "learningStats": {
          "type": "object",
          "properties": {
            "coursesCompleted": { "type": "number" },
            "hoursLeaned": { "type": "number" },
            "points": { "type": "number" }
          }
        }
      },
      "required": ["uid", "name", "email", "provider", "createdAt", "subscriptionPlan", "learningStats"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "System activity record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["userId", "userName", "action", "timestamp"]
    },
    "AdminConfig": {
      "title": "Admin Configuration",
      "description": "Global admin settings",
      "type": "object",
      "properties": {
        "currentAdminEmail": { "type": "string" },
        "lastTransferAt": { "type": "string", "format": "date-time" }
      },
      "required": ["currentAdminEmail"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course structure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["local", "gdrive", "youtube"] },
        "thumbnail": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "sourceType", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Courses collection"
    },
    "system_config/admin": {
      "schema": "AdminConfig",
      "description": "Admin authorization singleton"
    },
    "activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "User activity audit logs"
    }
  }
}
